# n8n stack environment configuration
# Copy this file to .env and fill in all values.
# NEVER commit the .env file (it's in .gitignore).

# Domain for the n8n instance (Caddy will provision TLS via Let's Encrypt)
DOMAIN=n8n.example.com

# PostgreSQL credentials
POSTGRES_USER=sigyard
POSTGRES_PASSWORD=changeme
POSTGRES_DB=n8n

# n8n basic auth (protects the n8n UI)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# n8n encryption key (used to encrypt credentials in the database)
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=changeme

# Timezone for scheduled workflows
GENERIC_TIMEZONE=UTC

# n8n Docker image tag (use a specific version for reproducibility, e.g., 1.84.3)
N8N_VERSION=stable